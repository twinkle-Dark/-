. 錯誤處理統一
目前代碼中有多處相似的錯誤處理邏輯，包括：
錯誤日誌記錄 (console.error)
用戶提示 (showToast)
UI元素恢復 (按鈕狀態重置等)
建議創建一個統一的錯誤處理函數：


/**
 * 統一處理錯誤的函數
 * @param {Error} error - 錯誤對象
 * @param {string} context - 錯誤發生的上下文/位置
 * @param {Object} options - 額外選項
 * @param {HTMLElement} options.element - 需要恢復狀態的元素（如按鈕）
 * @param {string} options.originalText - 元素的原始文字
 * @param {number} options.toastDuration - Toast 顯示時間
 * @param {Function} options.callback - 錯誤處理後的回調函數
 */
function handleError(error, context, options = {}) {
  // 1. 記錄錯誤
  console.error(`${context}時發生錯誤:`, error);
  
  // 2. 顯示用戶提示
  const message = `${context}時發生錯誤: ${error.message}`;
  const duration = options.toastDuration || 3000;
  showToast(message, duration);
  
  // 3. 恢復 UI 元素狀態
  if (options.element) {
    options.element.textContent = options.originalText || '儲存';
    options.element.disabled = false;
  }
  
  // 4. 執行額外回調
  if (options.callback && typeof options.callback === 'function') {
    options.callback(error);
  }
}
