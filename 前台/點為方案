## 方案三：智能點位群組化

### 實現細節
1. 距離計算功能：
   - 計算所有點位間的距離
   - 設定閾值來判斷哪些點位應該合併

2. 點位群組邏輯：
```javascript
// 設定合併距離閾值（像素）
const MERGE_THRESHOLD = 40;

// 計算兩點距離
function distance(p1, p2) {
  return Math.sqrt(
    Math.pow(p1.top - p2.top, 2) + 
    Math.pow(p1.left - p2.left, 2)
  );
}

// 找出所有需要合併的點位群組
function findClusters(hotspots) {
  const clusters = [];
  const processed = new Set();
  
  hotspots.forEach((hotspot, index) => {
    if (processed.has(index)) return;
    
    const rect = hotspot.getBoundingClientRect();
    const p1 = {
      top: rect.top,
      left: rect.left,
      element: hotspot
    };
    
    const cluster = [p1];
    processed.add(index);
    
    // 尋找附近的點位
    hotspots.forEach((h2, i2) => {
      if (index === i2 || processed.has(i2)) return;
      
      const rect2 = h2.getBoundingClientRect();
      const p2 = {
        top: rect2.top,
        left: rect2.left,
        element: h2
      };
      
      if (distance(p1, p2) < MERGE_THRESHOLD) {
        cluster.push(p2);
        processed.add(i2);
      }
    });
    
    clusters.push(cluster);
  });
  
  return clusters;
}

// 創建群組點位顯示
function createClusterView(clusters) {
  // 隱藏原始點位
  document.querySelectorAll('.hotspot').forEach(h => {
    h.style.display = 'none';
  });
  
  // 為每個群組創建代表點位
  clusters.forEach(cluster => {
    if (cluster.length === 1) {
      // 單點直接顯示
      cluster[0].element.style.display = 'block';
      return;
    }
    
    // 計算群組中心點
    const avgTop = cluster.reduce((sum, p) => sum + p.top, 0) / cluster.length;
    const avgLeft = cluster.reduce((sum, p) => sum + p.left, 0) / cluster.length;
    
    // 創建群組點位
    const clusterPoint = document.createElement('div');
    clusterPoint.className = 'hotspot cluster-point';
    clusterPoint.style.top = `${avgTop}px`;
    clusterPoint.style.left = `${avgLeft}px`;
    clusterPoint.innerHTML = `<div class="cluster-count">${cluster.length}</div>`;
    
    // 點擊時顯示該群組的所有點位
    clusterPoint.addEventListener('click', () => {
      clusterPoint.style.display = 'none';
      
      // 顯示群組內所有點位
      cluster.forEach(p => {
        p.element.style.display = 'block';
      });
      
      // 創建返回按鈕
      const backBtn = document.createElement('div');
      backBtn.className = 'cluster-back-btn';
      backBtn.textContent = '返回';
      backBtn.addEventListener('click', () => {
        // 隱藏群組點位
        cluster.forEach(p => {
          p.element.style.display = 'none';
        });
        // 顯示群組代表點
        clusterPoint.style.display = 'block';
        backBtn.remove();
      });
      
      document.querySelector('.floorplan').appendChild(backBtn);
    });
    
    document.querySelector('.floorplan').appendChild(clusterPoint);
  });
}

// 應用群組化
const hotspots = Array.from(document.querySelectorAll('.hotspot'));
