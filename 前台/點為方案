## 方案四：改進標籤顯示方式

### 實現細節
1. 改進標籤顯示方式：
   - 默認隱藏所有標籤
   - 鼠標懸停或點擊時顯示標籤
   - 為行動裝置提供更大點擊區域

2. 程式碼實現：
```javascript
// 改變標籤顯示方式
document.querySelectorAll('.hotspot').forEach(hotspot => {
  // 獲取並隱藏標籤
  const label = hotspot.querySelector('.hotspot-name');
  label.style.visibility = 'hidden';
  label.style.opacity = '0';
  label.style.transition = 'opacity 0.3s, visibility 0.3s';
  
  // 檢測設備類型
  const isMobile = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  
  if (isMobile) {
    // 行動裝置：點擊切換顯示
    let isLabelVisible = false;
    
    hotspot.addEventListener('click', function(e) {
      // 防止點擊事件冒泡到父元素
      e.stopPropagation();
      
      // 隱藏所有其他標籤
      document.querySelectorAll('.hotspot-name').forEach(l => {
        if (l !== label) {
          l.style.visibility = 'hidden';
          l.style.opacity = '0';
        }
      });
      
      // 切換當前標籤顯示狀態
      isLabelVisible = !isLabelVisible;
      
      if (isLabelVisible) {
        label.style.visibility = 'visible';
        label.style.opacity = '1';
        
        // 如果標籤已顯示，延遲觸發點位的正常點擊行為
        setTimeout(() => {
          if (isLabelVisible) {
            // 執行原本的點擊事件邏輯（打開模態窗）
            if (!timerInterval) {
              startTimer();
            }
            openModal(hotspot.getAttribute('data-location'));
            isLabelVisible = false;
          }
        }, 1500); // 1.5秒後如果用戶沒有點擊其他地方，執行原始點擊功能
      } else {
        label.style.visibility = 'hidden';
        label.style.opacity = '0';
      }
    });
    
    // 點擊其他區域時隱藏所有標籤
    document.addEventListener('click', function() {
      document.querySelectorAll('.hotspot-name').forEach(l => {
        l.style.visibility = 'hidden';
        l.style.opacity = '0';
      });
      isLabelVisible = false;
    });
    
  } else {
    // 桌面設備：懸停顯示
    hotspot.addEventListener('mouseenter', function() {
      label.style.visibility = 'visible';
      label.style.opacity = '1';
    });
    
    hotspot.addEventListener('mouseleave', function() {
      label.style.visibility = 'hidden';
      label.style.opacity = '0';
    });
  }
});
```

