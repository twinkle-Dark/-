系統統計訪客的居住地分布，生成一個排序後的數組，用於圓餅圖顯示。

### 7. 互動行為統計

```javascript
// 互動行為統計過程
// 1. 初始化互動類型計數映射
const interactionTypeMap = {};

// 2. 從訪客信息中統計參觀目的
for (let i = 1; i < visitorInfo.length; i++) {
    const row = visitorInfo[i];
    if (!row || row.length === 0) continue;
    
    if (visitPurposeIdx >= 0 && row[visitPurposeIdx]) {
        const purposes = row[visitPurposeIdx].split(', ');
        purposes.forEach(purpose => {
            interactionTypeMap[purpose] = (interactionTypeMap[purpose] || 0) + 1;
        });
    }
}

// 3. 從互動數據中統計互動類型
for (let i = 1; i < interactions.length; i++) {
    const row = interactions[i];
    if (!row || row.length === 0) continue;
    
    if (interactionTypeIdx >= 0 && row[interactionTypeIdx]) {
        const types = row[interactionTypeIdx].split(', ');
        types.forEach(type => {
            if (type && type.trim() !== '') {
                interactionTypeMap[type] = (interactionTypeMap[type] || 0) + 1;
            }
        });
    }
}

// 4. 將映射轉換為數組並排序
result.interactionCounts = Object.entries(interactionTypeMap)
    .map(([type, count]) => ({ type, count }))
    .sort((a, b) => b.count - a.count);
```

互動行為統計結合了訪客信息中的參觀目的和互動數據中的互動類型，生成一個排序後的數組，顯示各類互動行為的頻率。

### 8. 無效日期處理

```javascript
// 無效日期處理過程
// 1. 定義日期解析函數
const parseVisitorIdDate = function(recordId) {
    try {
        // 嘗試從recordId中解析日期
        if (recordId.includes('_20')) {
            const match = recordId.match(/20\d{8}/);
            if (match) {
                const dateString = match[0];
                const year = parseInt(dateString.substring(0, 4));
                const month = parseInt(dateString.substring(4, 6)) - 1; // 月份從0開始
                const day = parseInt(dateString.substring(6, 8));
                
                // 驗證日期有效性
                if (!isNaN(year) && !isNaN(month) && !isNaN(day) && 
                    month >= 0 && month < 12 && day >= 1 && day <= 31) {
                    // 進一步檢查日期有效性（考慮月份天數）
                    const daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
                    // 處理閏年二月
                    if (month === 1 && ((year % 4 === 0 && year % 100 !== 0) || year % 400 === 0)) {
                        if (day <= 29) {
                            return { year, month, day };
                        }
                    } else if (day <= daysInMonth[month]) {
                        return { year, month, day };
                    }
                }
            }
        }
    } catch (e) {
        console.error('解析recordId日期錯誤:', e, recordId);
    }
    // 無法解析日期時，返回月份為12（無效）
    return { month: 12 };
};

// 2. 在處理訪客趨勢時，無效日期的訪客被累計到monthlyVisitors[12]
// 3. 最後將無效日期數量保存到結果對象
result.invalidDateCount = monthlyVisitors[12];
```

系統對無效日期進行嚴格篩選，包括日期格式錯誤、月份超出範圍、日期超出當月天數等情況。所有無效日期的訪客被單獨計數，不會影響月度趨勢分析的準確性。

## 圖表實現

### 1. 訪客趨勢圖表 (折線圖)

```javascript
// 更新訪客趨勢圖表
updateVisitorTrendChart: function(monthlyData, invalidDateCount) {
    try {
        const canvas = document.getElementById('visitorTrendChart');
        if (!canvas) {
            console.warn('找不到訪客趨勢圖表元素');
            return;
        }
        
        if (!monthlyData || !Array.isArray(monthlyData)) {
            console.warn('訪客趨勢數據無效');
            return;
        }

        const ctx = canvas.getContext('2d');
        
        // 只使用有效月份數據 (排除索引 12)
        const validMonthlyData = monthlyData.slice(0, 12);
        
        // 使用Chart.js創建折線圖
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月'],
                datasets: [{
                    label: '訪客數量',
                    data: validMonthlyData,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderWidth: 2,
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: `訪客月度趨勢 (無效日期: ${invalidDateCount || 0})`
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    } catch (error) {
        console.error('更新訪客趨勢圖表時發生錯誤:', error);
    }
}
```

### 2. 訪客居住地分布 (圓餅圖)

```javascript
// 更新訪客居住地分布圖表
updatePopularAreasChart: function(locationData) {
    try {
        const canvas = document.getElementById('popularAreasChart');
        if (!canvas) {
            console.warn('找不到訪客居住地分布圖表元素');
            return;
        }
        
        if (!locationData || !Array.isArray(locationData) || locationData.length === 0) {
            console.warn('訪客居住地數據無效');
            return;
        }

        const ctx = canvas.getContext('2d');
        
        // 整理數據
        const labels = [];
        const data = [];
        const colors = [
            'rgba(255, 99, 132, 0.7)',
            'rgba(54, 162, 235, 0.7)',
            // ... 更多顏色
        ];
        
        // 排序數據並只取前7名
        const sortedData = [...locationData].sort((a, b) => b.count - a.count).slice(0, 7);
        
        sortedData.forEach((item, index) => {
            labels.push(item.area || '未知');
            data.push(item.count);
        });
        
        // 使用Chart.js創建圓餅圖
        new Chart(ctx, {
            type: 'pie',
            data: {
                labels: labels,
                datasets: [{
                    data: data,
                    backgroundColor: colors,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'right'
                    },
                    title: {
                        display: true,
                        text: '訪客居住地分布'
                    }
                }
            }
        });
    } catch (error) {
        console.error('更新訪客居住地分布圖表時發生錯誤:', error);
    }
}
```

